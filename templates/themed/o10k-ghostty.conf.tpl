# conditionals), so per-mode opacity is not expressible; this file stays
# minimal rather than inventing syntax.
#
# Ghostty applies later config-file includes over earlier ones, so this
# include must stay after Omarchy's theme include in ~/.config/ghostty/config.

cursor-color = {{ accent }}
